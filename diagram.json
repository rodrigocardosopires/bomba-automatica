{
  "version": 1,
  "author": "BombaAutom",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": -220,
      "left": -40,
      "attrs": { "pins": "i2c", "i2cAddress": "0x27" }
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sensor1000",
      "top": -110,
      "left": 230,
      "attrs": { "distance": "60" }
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sensor500",
      "top": 10,
      "left": 230,
      "attrs": { "distance": "50" }
    },
    { "type": "wokwi-relay-module", "id": "rele", "top": 160, "left": 230, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "bomba",
      "top": 140,
      "left": 400,
      "attrs": { "color": "blue", "label": "BOMBA" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_bomba",
      "top": 220,
      "left": 400,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_vermelho",
      "top": 250,
      "left": -160,
      "attrs": { "color": "red", "label": "AUTO" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_vermelho",
      "top": 330,
      "left": -160,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_verde",
      "top": 250,
      "left": -100,
      "attrs": { "color": "green", "label": "MANUAL" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_verde",
      "top": 330,
      "left": -100,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "emergencia",
      "top": 60,
      "left": -200,
      "attrs": { "value": "", "bounce": "0" }
    },
    {
      "type": "wokwi-text",
      "id": "txt_emergencia",
      "top": 30,
      "left": -250,
      "attrs": { "text": "EMERGENCIA\nesq: normal | dir: acionada" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "disjuntor",
      "top": 160,
      "left": -200,
      "attrs": { "value": "", "bounce": "0" }
    },
    {
      "type": "wokwi-text",
      "id": "txt_disjuntor",
      "top": 130,
      "left": -250,
      "attrs": { "text": "DISJUNTOR MANUAL\nesq: desligado | dir: ligado" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "lcd:GND", "esp:GND.1", "black", [] ],
    [ "lcd:VCC", "esp:VIN", "red", [] ],
    [ "lcd:SDA", "esp:D21", "green", [] ],
    [ "lcd:SCL", "esp:D22", "blue", [] ],

    [ "sensor1000:VCC", "esp:VIN", "red", [] ],
    [ "sensor1000:GND", "esp:GND.1", "black", [] ],
    [ "sensor1000:TRIG", "esp:D25", "orange", [] ],
    [ "sensor1000:ECHO", "esp:D34", "purple", [] ],

    [ "sensor500:VCC", "esp:VIN", "red", [] ],
    [ "sensor500:GND", "esp:GND.1", "black", [] ],
    [ "sensor500:TRIG", "esp:D26", "orange", [] ],
    [ "sensor500:ECHO", "esp:D35", "purple", [] ],

    [ "rele:VCC", "esp:VIN", "red", [] ],
    [ "rele:GND", "esp:GND.1", "black", [] ],
    [ "rele:IN", "esp:D23", "yellow", [] ],    [ "rele:COM", "esp:3V3", "red", [] ],
    [ "rele:NO", "bomba:A", "blue", [] ],
    [ "bomba:C", "r_bomba:1", "black", [] ],
    [ "r_bomba:2", "esp:GND.1", "black", [] ],

    [ "esp:D18", "led_vermelho:A", "red", [] ],
    [ "led_vermelho:C", "r_vermelho:1", "black", [] ],
    [ "r_vermelho:2", "esp:GND.2", "black", [] ],
    [ "esp:D19", "led_verde:A", "green", [] ],
    [ "led_verde:C", "r_verde:1", "black", [] ],
    [ "r_verde:2", "esp:GND.2", "black", [] ],

    [ "emergencia:2", "esp:D32", "red", [] ],
    [ "emergencia:1", "esp:GND.2", "black", [] ],

    [ "disjuntor:2", "esp:D33", "green", [] ],
    [ "disjuntor:3", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
